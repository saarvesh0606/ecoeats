# Environment — never commit real credentials
.env
.env.local

# Everything in here is a credential. The whole directory is ignored so a
# service-account file cannot be committed by accident regardless of its name
# (Firebase names them <project-id>-firebase-adminsdk-<hash>.json).
secrets/
*service-account*.json
*firebase-adminsdk*.json
# Signing and push material, wherever it lands. Unlike a leaked password these
# cannot be rotated by editing a file — the key itself has to be revoked.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Logs and coverage
*.log
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Expo (client)
node_modules/
.expo/
dist/

# Flutter / Dart / Pub (client). Patterns are unanchored so they hold whether
# the Flutter app sits at the root or in a subdirectory.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
migrate_working_dir/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json

# Editors / OS
# Local agent tooling, not project code. settings.local.json is machine-scoped
# by convention and carries absolute paths from this developer's home
# directory; nothing here is useful to anyone cloning the repo.
.claude/
.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini
