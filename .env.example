# Copy to .env for local development.
# .env is gitignored — never commit real credentials.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://ecoeats:ecoeats@localhost:5432/ecoeats

# Separate database for the test suite. Required — pytest fails without it.
TEST_DATABASE_URL=postgresql://ecoeats:ecoeats@localhost:5432/ecoeats_test

APP_ENV=development

# Observability. LOG_JSON defaults to structured JSON in production and
# readable console lines otherwise; set it explicitly to override.
LOG_LEVEL=INFO
# LOG_JSON=true

# Firebase — from console → Project settings.
# The service-account JSON is a credential: keep it in secrets/ (gitignored)
# and never commit it.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Cloudinary — listing photos. cloud_name and api_key are not secret.
# The secret is read from a file kept in secrets/ (gitignored).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET_FILE=secrets/cloudinary.txt

# Exact-match CORS allowlist, comma separated.
# 8081 = Expo Metro, 19006 = Expo web
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Restrict accounts to one email domain, e.g. asu.edu. Blank (the default and
# what ships) means any verified address is accepted.
#
# Set this only when you mean it: Sign in with Apple issues
# @privaterelay.appleid.com addresses and Google accounts arrive on whatever
# domain the person has, so any value here disables both buttons for most
# people. Intended for restoring the ASU-only rule once ASU approves it.
ALLOWED_EMAIL_DOMAIN=

# Development only. Accepts dev:<slug> stand-in tokens so the client can be
# tested before real accounts exist. The app refuses to start if this is
# true while APP_ENV=production.
DEV_AUTH_BYPASS=false

# Redis — shared store for rate limiting (and later caching / realtime).
# Without it the limiter falls back to in-memory (single instance only).
REDIS_URL=redis://localhost:6379/0

# Connection pool (per process). Behind a pooler set DB_STATEMENT_CACHE=false.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_CACHE=true

# In a container, pass the Firebase service account as JSON instead of a path:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Error tracking (optional). Inactive until set.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1
