# Copy to .env. All EXPO_PUBLIC_* values are bundled into the client and are
# NOT secret — Firebase publishes these in every web/mobile app by design.

# Where the FastAPI backend is reachable from the app.
#   - web / same machine:  http://localhost:8000
#   - a physical phone:    http://<your-PC-LAN-IP>:8000  (e.g. http://192.168.1.20:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase web config (Project settings → General → Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
