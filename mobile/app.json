{
	"expo": {
		"name": "EcoEats",
		"slug": "ecoeats",
		"version": "0.1.0",
		"orientation": "portrait",
		"scheme": "ecoeats",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.ecoeats.app"
		},
		"android": {
			"package": "com.ecoeats.app"
		},
		"web": {
			"bundler": "metro",
			"output": "single"
		},
		"plugins": ["expo-router", "expo-secure-store"],
		"experiments": {
			"typedRoutes": true
		}
	}
}
