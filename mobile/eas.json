{
	"cli": {
		"version": ">= 12.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"SENTRY_DISABLE_AUTO_UPLOAD": "true"
			},
			"ios": {
				"simulator": false
			},
			"channel": "development"
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"SENTRY_DISABLE_AUTO_UPLOAD": "true"
			},
			"android": {
				"buildType": "apk"
			},
			"channel": "preview"
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"SENTRY_DISABLE_AUTO_UPLOAD": "true"
			},
			"channel": "production"
		}
	},
	"submit": {
		"production": {}
	}
}
